# SAATHI Environment Configuration Example
PROJECT_NAME="SAATHI Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & Cryptography
SECRET_KEY="saathi-sih-production-secure-jwt-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL by default, SQLite fallback supported)
DATABASE_URL="sqlite:///./saathi.db"
# DATABASE_URL="postgresql://saathi_user:saathi_password@localhost:5432/saathi_db"

# Model Artifacts Path
MODEL_PATH="../ml/models/support_priority_model.joblib"
METADATA_PATH="../ml/models/model_metadata.json"

# CORS Configuration
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000"]'

# Default Admin Credentials for Initialization
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_EMAIL="admin@forces.gov.in"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
