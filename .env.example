# SAATHI Environment Configuration Template
# Copy this file to .env and configure strong secrets before running in production

PROJECT_NAME="SAATHI AI Welfare Decision Support System"
ENVIRONMENT="development"
VERSION="1.0.0"

# Cryptographic Secret Key for JWT Signing (Generate with: openssl rand -hex 32)
SECRET_KEY="generate-a-strong-32-byte-hex-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection (PostgreSQL in production, SQLite in development)
DATABASE_URL="sqlite:///./saathi.db"

# Admin Initial Account
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_EMAIL="admin@forces.gov.in"
INITIAL_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
