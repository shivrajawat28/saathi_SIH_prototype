# Git Ignore for SAATHI Repository

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# Python & ML Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.joblib.bak

# Node & Frontend
node_modules/
dist/
build/
.npm
*.tsbuildinfo

# OS & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.idea/
.vscode/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
